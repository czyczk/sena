# Baseline: `cargo new` default for a binary project.
/target

# Local build-tool caches and the copied fallback toolchain (kept in-repo so
# agents can write them freely; ~/.cargo / ~/.rustup were read-only on this
# WSL box at the time - see notes/build-and-cross.md).
/.cargo-home/
/.toolchains/
/.cache/

# Generated cross-build intermediates.
/build/

# Python.
__pycache__/
*.pyc

# Editor / OS noise.
.idea/
.vscode/
*.swp
*~
.DS_Store

# Keep these on purpose:
#   Cargo.lock  -- this workspace contains binaries, so lockfile is committed.
#   bin/        -- checked-in launchers/symlinks used by senaenc on this host
#                  are ignored, except the .gitkeep placeholder.
/bin/*
!/bin/.gitkeep

# transient cargo homes created by failure simulations
/.cargo-empty/
